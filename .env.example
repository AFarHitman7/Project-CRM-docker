PG_PORT=5435
PG_HOST=db
PG_USER=postgres
PG_PASSWORD=change_me_in_your_local_dotenv
PG_NAME=crm

NODE_ENV=dev

VITE_API_URL=http://localhost:4000

# Generate dev-only values locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit real secrets. Production uses different secrets entirely.
JWT_SECRET=dev_only_replace_me_64_bytes_hex
SIN_ENC_KEY=dev_only_replace_me_32_bytes_hex

ADMIN_USERNAME=Admin
ADMIN_NAME=John Doe
ADMIN_PASSWORD=dev_only_replace_me

# Portable default; override per-machine in your untracked .env
HST_DOCS_UPLOAD_DIR=./uploads
